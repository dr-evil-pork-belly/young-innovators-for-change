# Contact form delivery. Without these three, /api/contact returns a real error
# instead of pretending to send. Set them in Vercel, Settings, Environment
# Variables, for Production, Preview and Development.
#
# Full setup sequence, including the DNS records: claude/19-contact-and-email.md
# Check your work after deploying:  npm run build && npm run contact:check

# From resend.com, API Keys. Sending permission is enough; it does not need full
# access. Treat it like a password: it is not in this file and never in git.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The monitored inbox that receives every submission. Must match
# ORG.contactEmail in content/org.ts, which is what the site prints publicly.
CONTACT_TO=hello@innovateyouth.org

# The sender. Must be on a domain verified in Resend. Add the ROOT domain there:
# Resend puts its own MX and SPF on `send.innovateyouth.org` by itself, so they
# cannot collide with the root MX records that make hello@ able to receive.
# Adding `send.innovateyouth.org` as the domain instead gets you records at
# send.send.innovateyouth.org, which works and reads like a typo forever.
CONTACT_FROM=site@innovateyouth.org

# Only set by scripts/contact-check.mjs, which points it at a local recorder so
# the route can be tested without sending mail. Leave it unset everywhere else.
# RESEND_API_URL=
